# agentbox OMP image: localhost/omp-env plus what the sandbox needs.
#
# Build with `make omp-image` (tags localhost/agentbox-omp:latest and :<date>). The base image is Tim's
# omp-env (~/repos/omp-env); nothing here changes it.
#
# Why each change:
#   * /root is 0700 in the base, and bun lives in /root/.bun. The sandbox runs as the host user
#     (--userns=keep-id), so /root is opened to 0755, after a build step that fails if /root holds
#     credential-like files (review 2026-10-01 #8).
#   * /root/.omp -> $AB_HOME/.omp: plugin links written by `omp-env install` (which runs as root) are
#     absolute /root/.omp/... paths; inside a session ~/.omp is under the host user's home.
#   * python-is-python3, debugpy: the debugger probe needed both (design: OMP adapter).
#   * chromium: OMP's browser tool uses PUPPETEER_EXECUTABLE_PATH, so ~/.omp/puppeteer is not mounted.
#   * python3-venv and curl: the trial (2 Oct) found agents need a venv and an HTTP client in the session.
#   * the compose tool (dev tier) and debugpy, from requirements.txt: every package and dependency pinned
#     with hashes (pip --require-hashes);
#   * podman-remote 5.7.0 (below), replacing Debian's 4.3 client on PATH.
ARG BASE=localhost/omp-env:latest
FROM ${BASE}
ARG AB_HOME=/home/vmuser

# rsync: agentbox's own test suite shells out to it (the pre-session grant snapshot), so `make test` run
# inside a session needs it -- see images/claude/Containerfile.
RUN apt-get update && apt-get install -y --no-install-recommends python-is-python3 chromium python3-venv curl \
    rsync && apt-get clean
COPY requirements.txt /tmp/agentbox-requirements.txt
RUN pip install --no-cache-dir --break-system-packages --require-hashes -r /tmp/agentbox-requirements.txt
# /root is about to become readable by the session user: refuse to build if it holds credentials.
RUN found=$(find /root -maxdepth 4 \( -name .npmrc -o -name .git-credentials -o -name .netrc -o -name .pypirc \
        -o -name credentials -o -name '*.pem' -o -name 'id_*' -o -path '/root/.ssh/*' -o -path '/root/.config/gh/*' \
        -o -path /root/.docker/config.json -o -path '/root/.aws/*' -o -path '/root/.claude/*' \) -print); \
    if [ -n "$found" ]; then echo "credential-like files in /root: $found" >&2; exit 1; fi
RUN chmod 0755 /root && ln -sfn "${AB_HOME}/.omp" /root/.omp

# podman-remote 5.x, pinned and checksum-verified (version and checksum from the Makefile, shared with
# images/claude), at /usr/local/bin/podman, ahead of Debian's podman 4.3 in /usr/bin on PATH.
ARG PODMAN_REMOTE_VERSION
ARG PODMAN_REMOTE_SHA256
ADD --checksum=sha256:${PODMAN_REMOTE_SHA256} \
    https://github.com/podman-container-tools/podman/releases/download/v${PODMAN_REMOTE_VERSION}/podman-remote-static-linux_amd64.tar.gz \
    /tmp/podman-remote.tar.gz
RUN tar -xzf /tmp/podman-remote.tar.gz -C /tmp \
    && install -m 0755 /tmp/bin/podman-remote-static-linux_amd64 /usr/local/bin/podman \
    && rm -f /tmp/podman-remote.tar.gz /tmp/bin/podman-remote-static-linux_amd64

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PIP_CACHE_DIR=/tmp/pip-cache
LABEL agentbox=1 \
      org.opencontainers.image.title="agentbox-omp" \
      org.opencontainers.image.description="omp-env for agentbox sessions (keep-id user, chromium, debugpy)"
WORKDIR /
ENTRYPOINT []
CMD ["omp"]
