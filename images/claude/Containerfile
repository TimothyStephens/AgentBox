# agentbox Claude image: agentbox-base plus the Claude Code CLI, at a pin.
#
# Build with `make claude-image` (tags localhost/agentbox-claude:latest and :<date>). It no longer comes
# FROM localhost/claudecode -- the CLI is installed here, so the version in the image is the version this
# file names, and `ab selftest` can hold it to that.
#
# How the pin is enforced, which is the point of installing it ourselves:
#   * `npm install` of an EXACT version verifies the tarball against the registry's integrity metadata
#     before unpacking it -- that is npm's own check, and `--no-audit --no-fund` keeps it to that;
#   * the build then asserts the installed binary reports the pinned version, so this file cannot claim a
#     version the image does not have;
#   * the pin goes on the `agentbox.cli-version` label, which `ab selftest` reports and `ab image build`
#     compares a personal layer against.
# The published integrity for the pinned version is recorded below so a change of pin is a deliberate edit
# with a value to look up, not a bump.
#
# Auto-update is off IN THE IMAGE, not only in the session environment: a session's Claude Code must be the
# one this file pinned, and an updater that replaced it would make the label a lie and the selftest wrong.
ARG BASE=localhost/agentbox-base:latest
FROM ${BASE}

# After the FROM, so it is in scope where it is used (see images/base/Containerfile on why that matters).
# @anthropic-ai/claude-code@2.1.318, npm 4 Nov 2026, integrity
# sha512-OTJgLxcvWefv8IdTsq5n90Z2IxEhLwKqHUBhwZYE4odXzKA/Tb6p2Zb5Iy9Vq7JIVcNZzn9cPxW5sb42wLF95Q==
ARG CLAUDE_VERSION=2.1.318
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
RUN set -eux; \
    npm install -g --no-audit --no-fund --fetch-retries 5 \
        "@anthropic-ai/claude-code@${CLAUDE_VERSION}"; \
    npm cache clean --force; \
    command -v claude; \
    claude --version; \
    claude --version | grep -F "${CLAUDE_VERSION}"

# A credential-like file in the image would be readable by the session user. The base is a public image and
# npm runs as root here, so this is a cheap assertion rather than a suspicion.
RUN found=$(find /root -maxdepth 4 \( -name .npmrc -o -name .git-credentials -o -name .netrc \
        -o -name .pypirc -o -name credentials -o -name '*.pem' -o -name 'id_*' \
        -o -path '/root/.ssh/*' -o -path '/root/.config/gh/*' -o -path '/root/.aws/*' \
        -o -path '/root/.claude/*' \) -print); \
    if [ -n "$found" ]; then echo "credential-like files in /root: $found" >&2; exit 1; fi

LABEL agentbox=1 \
      agentbox.cli-version="${CLAUDE_VERSION}" \
      org.opencontainers.image.title="agentbox-claude" \
      org.opencontainers.image.description="Claude Code ${CLAUDE_VERSION} on agentbox-base"
WORKDIR /
ENTRYPOINT []
CMD ["claude"]
